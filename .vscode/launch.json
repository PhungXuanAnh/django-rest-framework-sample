{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debugpy",
            "type": "debugpy",
            "request": "attach",
            "justMyCode": false,
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/source",
                    "remoteRoot": "/app",
                }
            ]
        },
        {
            "name": "Run directly",
            "request": "launch",
            "justMyCode": false,
            "program": "${workspaceFolder}/source/manage.py",
            "args": [
                "runserver",
                "0.0.0.0:8027"
            ],
            "django": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "main.settings.local"
            }
        }
    ]
}